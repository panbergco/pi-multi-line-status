{
  "name": "pi-multi-line-status",
  "version": "0.1.0",
  "description": "Multi-line status bar for the pi coding agent — Claude Code-style identity line + meters line, with dual TPS meters (persistent sparkline + live gauge)",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "statusline",
    "footer",
    "tps"
  ],
  "homepage": "https://github.com/panbergco/pi-multi-line-status#readme",
  "bugs": {
    "url": "https://github.com/panbergco/pi-multi-line-status/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panbergco/pi-multi-line-status.git"
  },
  "files": [
    "bin/",
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pmls": "bin/pmls.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@firstpick/pi-utils": "^0.2.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/statusbar/index.ts",
      "./extensions/tps-meter.ts"
    ],
    "image": "https://raw.githubusercontent.com/panbergco/pi-multi-line-status/main/docs/screenshot.png"
  }
}
