{
  "name": "pi-multi-line-status",
  "version": "0.1.0",
  "description": "Multi-line status bar for the pi coding agent \u2014 Claude Code-style identity line + meters line, with dual TPS meters (persistent sparkline + live gauge)",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "bin/",
    "extensions/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panbergco/pi-multi-line-status.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "statusline",
    "footer",
    "tps"
  ],
  "dependencies": {
    "@firstpick/pi-utils": "^0.2.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/statusbar/index.ts",
      "./extensions/tps-meter.ts"
    ]
  },
  "bin": {
    "pmls": "./bin/pmls.mjs"
  }
}
